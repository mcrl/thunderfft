+              x_frag[j_a][j_b][k].x[i + acc_frag_1[j_a][j_b][k].num_elements] = acc_frag_1[j_a][j_b][k].x[i];
+            }
+          }
+        }
+      }
+
+      }
+
+      wmma::store_matrix_sync(reinterpret_cast<half *>(a_real), acc_frag_1[0][0][0], sqrt_N, wmma::mem_col_major);
